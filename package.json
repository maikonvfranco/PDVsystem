{
  "name": "pdv",
  "private": true,
  "version": "2.2.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/maikonvfranco/criandopdv.git"
  },
  "type": "module",
  "main": "electron.js",
  "description": "Sistema de Frente de Caixa PDV",
  "author": "Maikon Franco Digital <maikonvfranco@gmail.com>",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "publish": "npm run build && electron-builder --publish always",
    "dev:electron": "concurrently \"npm run dev\" \"electron .\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "electron-updater": "^6.8.9",
    "firebase": "^12.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.18.0",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.maiikonfrancodigital.pdv",
    "productName": "PDV",
    "files": [
      "electron.js",
      "preload.js",
      "build-react/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "maikonvfranco",
        "repo": "criandopdv"
      }
    ]
  }
}
